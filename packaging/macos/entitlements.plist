<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  PrintNest macOS entitlements (SPEC section 7, OS hardening).
  App Sandbox ON. The ONLY file access is what the user picks in a dialog.
  There is deliberately NO com.apple.security.network.client or
  network.server entitlement: the sandbox blocks all network access.
  Changes to this file require CODEOWNERS review.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>
